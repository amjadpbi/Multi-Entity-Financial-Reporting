				        {31,"A2","Cash Flow from Operating"},
				        {32,"A3","Cash Flow from Investing"},
				        {33,"A4","Cash Flow from Financing"},
				        {34,"A5","Beginning cash"},
				        {35,"A6","Cash Balance"},
				        {36,"A7","LTM ave cash balance"},
				        {37,"A8","Net Foreign Exchange Difference"},
				        {38,"A9","Checks"}
				    }
				),
				DISTINCT('MONTH'[MONTH])
				)
				```

