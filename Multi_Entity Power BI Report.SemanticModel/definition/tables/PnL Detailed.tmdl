	column MONTH
		lineageTag: b357e508-2937-40ab-9696-78d318fa1675
		summarizeBy: none
		isNameInferred
		sourceColumn: MONTH[MONTH]

		annotation SummarizationSetBy = Automatic

	column Actual =
			IF(ISBLANK(CALCULATE(SUM('UT & US Data 2025-26'[Amount]),
			FILTER('UT & US Data 2025-26','UT & US Data 2025-26'[Month] = 'PnL Detailed'[MONTH] &&
			'UT & US Data 2025-26'[BS HL] = 'PnL Detailed'[Account] &&
			'UT & US Data 2025-26'[Year] = 2026
			)
			)),0,
			CALCULATE(SUM('UT & US Data 2025-26'[Amount]),
			FILTER('UT & US Data 2025-26','UT & US Data 2025-26'[Month] = 'PnL Detailed'[MONTH] &&
			'UT & US Data 2025-26'[BS HL] = 'PnL Detailed'[Account] &&
			'UT & US Data 2025-26'[Year] = 2026
			)
			))
		formatString: #,0.00
		lineageTag: be8f19db-5c1a-4f22-a3c5-488bb53e7497
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Actual Final' = ```
			
			SWITCH(
			    TRUE(),
			
			    /* ---------------- ASSETS ---------------- */
			
			    -- F (1 to 8)
			    'PnL Detailed'[Index] = 9 ,
			        CALCULATE(
			            SUM('PnL Detailed'[Actual]),
			            FILTER(
			                'PnL Detailed',
			                'PnL Detailed'[MONTH] = EARLIER('PnL Detailed'[MONTH]) &&
			                'PnL Detailed'[Index] IN {1,2,3,4,5,6,7,8}
			            )
			        ),
			
			    -- F (10 to 12)
			    'PnL Detailed'[Index] = 13 ,
			        CALCULATE(
			            SUM('PnL Detailed'[Actual]),
			            FILTER(
			                'PnL Detailed',
			                'PnL Detailed'[MONTH] = EARLIER('PnL Detailed'[MONTH]) &&
			                'PnL Detailed'[Index] IN {10,11,12}
			            )
			        ),
			
			    -- 1 to 8 and 10 to 12 (Total Assets)
			    'PnL Detailed'[Index] = 14 ,
			        CALCULATE(
			            SUM('PnL Detailed'[Actual]),
			            FILTER('PnL Detailed',
			                'PnL Detailed'[MONTH] = EARLIER('PnL Detailed'[MONTH]) &&
			                'PnL Detailed'[Index] IN {1,2,3,4,5,6,7,8,10,11,12}
			            )
			        ),
			
			    /* ---------------- CURRENT LIABILITIES ---------------- */
			
			    -- F (15 to 20)
			    'PnL Detailed'[Index] = 21 ,
			        CALCULATE(
			            SUM('PnL Detailed'[Actual]),
			            FILTER(
			                'PnL Detailed',
			                'PnL Detailed'[MONTH] = EARLIER('PnL Detailed'[MONTH]) &&
			                'PnL Detailed'[Index] IN {15,16,17,18,19,20}
			            )
			        ),
			
			    /* ---------------- NON-CURRENT LIABILITIES ---------------- */
			
			    -- F (22 to 24)
			    'PnL Detailed'[Index] = 25 ,
			        CALCULATE(
			            SUM('PnL Detailed'[Actual]),
			            FILTER(
			                'PnL Detailed',
			                'PnL Detailed'[MONTH] = EARLIER('PnL Detailed'[MONTH]) &&
			                'PnL Detailed'[Index] IN {22,23,24}
			            )
			        ),
			
			    /* ---------------- TOTAL LIABILITIES ---------------- */
			
			    -- F (15 to 20 and 22 to 24)
			    'PnL Detailed'[Index] = 26 ,
			        CALCULATE(
			            SUM('PnL Detailed'[Actual]),
			            FILTER(
			                'PnL Detailed',
			                'PnL Detailed'[MONTH] = EARLIER('PnL Detailed'[MONTH]) &&
			                'PnL Detailed'[Index] IN {15,16,17,18,19,20,22,23,24}
			            )
			        ),
			
			    /* ---------------- NET ASSETS ---------------- */
			
			    -- 1–8 + 10–12 – 15–20 – 22–24
			    'PnL Detailed'[Index] = 27 ,
			        VAR Assets =
			            CALCULATE(
			                SUM('PnL Detailed'[Actual]),
			                FILTER('PnL Detailed',
			                    'PnL Detailed'[MONTH] = EARLIER('PnL Detailed'[MONTH]) &&
			                    'PnL Detailed'[Index] IN {1,2,3,4,5,6,7,8,10,11,12}
			                )
			            )
			        VAR Liabilities =
			            CALCULATE(
			                SUM('PnL Detailed'[Actual]),
			                FILTER('PnL Detailed',
			                    'PnL Detailed'[MONTH] = EARLIER('PnL Detailed'[MONTH]) &&
			                    'PnL Detailed'[Index] IN {15,16,17,18,19,20,22,23,24}
			                )
			            )
			        RETURN Assets - Liabilities,
			
			    /* ---------------- NET WORKING CAPITAL ---------------- */
			
			    -- (2–8) – (15–20)
			    'PnL Detailed'[Index] = 28 ,
			        VAR A_2_8 =
			            CALCULATE(
			                SUM('PnL Detailed'[Actual]),
			                FILTER('PnL Detailed',
			                    'PnL Detailed'[MONTH] = EARLIER('PnL Detailed'[MONTH]) &&
			                    'PnL Detailed'[Index] IN {2,3,4,5,6,7,8}
			                )
			            )
			        VAR L_15_20 =
			            CALCULATE(
			                SUM('PnL Detailed'[Actual]),
			                FILTER('PnL Detailed',
			                    'PnL Detailed'[MONTH] = EARLIER('PnL Detailed'[MONTH]) &&
			                    'PnL Detailed'[Index] IN {15,16,17,18,19,20}
			                )
			            )
			        RETURN A_2_8 - L_15_20,
			
			    /* ---------------- NET ASSETS DUPLICATE ---------------- */
			
			    'PnL Detailed'[Index] = 29 ,
			        VAR Assets2 =
			            CALCULATE(
			                SUM('PnL Detailed'[Actual]),
			                FILTER('PnL Detailed',
			                    'PnL Detailed'[MONTH] = EARLIER('PnL Detailed'[MONTH]) &&
			                    'PnL Detailed'[Index] IN {1,2,3,4,5,6,7,8,10,11,12}
			                )
			            )
			        VAR Liabilities2 =
			            CALCULATE(
			                SUM('PnL Detailed'[Actual]),
			                FILTER('PnL Detailed',
			                    'PnL Detailed'[MONTH] = EARLIER('PnL Detailed'[MONTH]) &&
			                    'PnL Detailed'[Index] IN {15,16,17,18,19,20,22,23,24}
			                )
			            )
			        RETURN Assets2 - Liabilities2,
			
			    /* ---------------- DEFAULT: row Actual ---------------- */
			
			    'PnL Detailed'[Actual]
			)
			
			```
		formatString: #,0.00
		lineageTag: 9552308a-c469-481a-981a-eb0a46fc7f29
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

